<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.DetailController">

    <top>
        <Label text="Detalle del Contenido"/>
    </top>

    <center>
        <GridPane hgap="10" vgap="10">
            <children>
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Fecha de creación:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="dateField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="typeField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Plataforma destino:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="platformField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </children>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="20">
            <children>
                <Button text="Publicar" fx:id="publishButton" onAction="#handlePublish"/>
                <Button text="Editar" fx:id="editButton" onAction="#handleEdit"/>
            </children>
        </HBox>
    </bottom>
</BorderPane>